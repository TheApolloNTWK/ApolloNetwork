---
/**
 * Interim APOLLO Network mark + wordmark.
 *
 * The mark (a core, an orbit and a single node) is a placeholder drawn for
 * this site and is intended to be replaced by final brand artwork. Swap the
 * <svg> below; nothing else depends on its internals.
 */
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="3.2" fill="currentColor"></circle>
    <ellipse
      cx="16"
      cy="16"
      rx="13"
      ry="5.5"
      transform="rotate(-28 16 16)"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      opacity="0.7"
    ></ellipse>
    <circle class="logo__node" cx="27.3" cy="10" r="1.9"></circle>
  </svg>
  <span class="logo__type">
    <span class="logo__primary">APOLLO</span>
    <span class="logo__secondary">NETWORK</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--c-text);
    line-height: 1;
  }

  .logo__mark {
    width: 1.9em;
    height: 1.9em;
  }

  .logo__node {
    fill: var(--c-cyan);
  }

  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 0.32em;
    font-family: var(--font-display);
  }

  .logo__primary {
    font-size: 1.12em;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .logo__secondary {
    font-size: 0.56em;
    font-weight: 500;
    letter-spacing: 0.62em;
    color: var(--c-text-muted);
  }

  .logo--sm {
    font-size: 0.95rem;
  }

  .logo--lg {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
</style>
