---
/**
 * Opening block for secondary pages: eyebrow, H1, lead, and a quiet orbital
 * figure that echoes the home hero without repeating it.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="intro" aria-labelledby="page-title">
  <div class="intro__art" aria-hidden="true">
    <svg viewBox="0 0 600 600" focusable="false">
      <defs>
        <radialGradient id="intro-core" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#00e0ff" stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color="#1b4dff" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <g class="intro__orbits">
        <ellipse cx="300" cy="300" rx="280" ry="96" transform="rotate(-24 300 300)"></ellipse>
        <ellipse cx="300" cy="300" rx="220" ry="150" transform="rotate(32 300 300)"></ellipse>
        <circle cx="300" cy="300" r="170"></circle>
        <circle cx="300" cy="300" r="96" class="intro__dashed"></circle>
      </g>
      <circle cx="300" cy="300" r="60" fill="url(#intro-core)" opacity="0.5"></circle>
      <circle cx="300" cy="300" r="5" class="intro__core"></circle>
      <circle cx="555" cy="185" r="4" class="intro__sat"></circle>
      <circle cx="170" cy="130" r="3" class="intro__sat intro__sat--dim"></circle>
    </svg>
  </div>

  <div class="container intro__content">
    <p class="label intro__eyebrow">
      <span class="intro__rule" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 id="page-title" class="intro__title">
      {title}
    </h1>
    <p class="intro__lead">{lead}</p>
    <slot />
  </div>
</section>

<style>
  .intro {
    position: relative;
    padding-block: calc(var(--header-h) + clamp(4rem, 10vw, 9rem)) clamp(3rem, 6vw, 6rem);
    overflow: clip;
    border-bottom: var(--border);
  }

  .intro::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--c-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
    background-size: 96px 96px;
    mask-image: radial-gradient(80% 90% at 85% 40%, #000, transparent 75%);
    opacity: 0.4;
    pointer-events: none;
  }

  .intro__art {
    position: absolute;
    top: 50%;
    right: -8%;
    width: min(70vw, 44rem);
    transform: translateY(-46%);
    pointer-events: none;
  }

  .intro__orbits {
    fill: none;
    stroke: rgb(120 160 255 / 0.22);
    stroke-width: 1;
  }

  .intro__dashed {
    stroke-dasharray: 2 7;
  }

  .intro__core {
    fill: #fff;
    filter: drop-shadow(0 0 8px #00e0ff);
  }

  .intro__sat {
    fill: var(--c-cyan);
    filter: drop-shadow(0 0 6px #00e0ff);
  }

  .intro__sat--dim {
    fill: var(--c-blue-bright);
    filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro__art svg {
      animation: drift 60s linear infinite;
    }
  }

  @keyframes drift {
    to {
      rotate: 360deg;
    }
  }

  @media (max-width: 767px) {
    .intro__art {
      top: 0;
      right: -35%;
      width: 110vw;
      transform: none;
      opacity: 0.55;
    }
  }

  .intro__content {
    position: relative;
  }

  /* Arrival mirrors the home hero: labels fade, headings settle in place. */
  @media (prefers-reduced-motion: no-preference) {
    .intro__eyebrow,
    .intro__content > :global(:nth-child(n + 4)) {
      animation: intro-arrive 1s var(--ease-out) backwards;
    }

    .intro__content > :global(:nth-child(n + 4)) {
      animation-delay: 380ms;
    }

    .intro__title,
    .intro__lead {
      animation: intro-settle 1.1s var(--ease-out) backwards;
    }

    .intro__lead {
      animation-delay: 140ms;
    }

    .intro__art {
      animation: intro-arrive 1.8s var(--ease-out) backwards;
    }
  }

  @keyframes intro-arrive {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  @keyframes intro-settle {
    from {
      translate: 0 0.3em;
    }
  }

  .intro__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-blue-bright);
  }

  .intro__rule {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }

  .intro__title {
    max-width: 15ch;
    margin-top: var(--s-6);
    font-size: var(--fs-h1);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  .intro__lead {
    max-width: 38rem;
    margin-top: var(--s-6);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--c-text-muted);
  }
</style>
