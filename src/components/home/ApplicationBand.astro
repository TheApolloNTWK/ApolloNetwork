---
import Button from '../Button.astro';
import StatusTag from '../StatusTag.astro';
import { layers, projectFacts } from '../../data/project';
---

<section class="band section" aria-labelledby="band-title">
  <div class="band__glow" aria-hidden="true"></div>
  <div class="container band__layout">
    <div class="band__text" data-reveal>
      <p class="label label--signal band__eyebrow">
        <span class="band__index">06</span>
        <span class="band__rule" aria-hidden="true"></span>
        The APOLLO Network application
      </p>
      <h2 id="band-title" class="band__title">
        Also in development: our own intelligence environment.
      </h2>
      <p class="band__body">
        Alongside client work, APOLLO Network is developing a personal intelligence environment — a
        real, working system in private development: a primary interface you can talk to,
        coordinating specialist agents, multiple models, tools and memory, within an authority
        structure its owner controls.
      </p>
      <div class="band__tag">
        <StatusTag status="private" />
      </div>
      <Button href="application/" variant="ghost">
        About the application
      </Button>
    </div>

    <div class="band__panel" data-reveal data-reveal-order="1">
      <ol class="band__layers" role="list" aria-label="Layers of the system">
        {layers.map((layer, i) => (
          <li class="band__layer">
            <span class="band__layer-num" aria-hidden="true">
              L{i + 1}
            </span>
            <span class="band__layer-name">{layer.name}</span>
            <span class="band__layer-role">{layer.role}</span>
          </li>
        ))}
      </ol>
      <dl class="band__facts">
        {projectFacts.map((f) => (
          <div>
            <dt class="label">{f.term}</dt>
            <dd>{f.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: clip;
    border-block: var(--border);
    background: var(--c-space);
  }

  .band__glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: 60rem;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(27 77 255 / 0.16), transparent);
    pointer-events: none;
  }

  .band__layout {
    position: relative;
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .band__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-9);
    }
  }

  .band__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .band__index {
    color: var(--c-text-subtle);
  }

  .band__rule {
    width: 1.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .band__title {
    margin-top: var(--s-5);
    font-size: var(--fs-h2);
  }

  .band__body {
    max-width: 34rem;
    margin-top: var(--s-5);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  .band__tag {
    margin-block: var(--s-6);
  }

  /* ── Panel ──────────────────────────────────────────────── */
  .band__panel {
    position: relative;
    padding: var(--s-5);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, rgb(11 30 58 / 0.45), rgb(5 8 20 / 0.6));
    box-shadow: var(--shadow-panel);
  }

  /* HUD corner marks */
  .band__panel::before,
  .band__panel::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--c-cyan);
    border-style: solid;
  }

  .band__panel::before {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .band__panel::after {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  .band__layers {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .band__layer {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, auto);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    border: var(--border);
    border-radius: var(--radius-xs);
    background: rgb(3 5 11 / 0.5);
    transition:
      border-color var(--dur-base) var(--ease-standard),
      transform var(--dur-base) var(--ease-out);
  }

  .band__layer:hover {
    border-color: var(--c-line-signal);
    transform: translateX(4px);
  }

  .band__layer-num {
    font-family: var(--font-display);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    color: var(--c-blue-bright);
  }

  .band__layer-name {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
  }

  .band__layer-role {
    font-size: var(--fs-small);
    color: var(--c-text-subtle);
    text-align: right;
  }

  .band__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-4);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: var(--border);
  }

  .band__facts dd {
    margin-top: var(--s-1);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  @media (max-width: 479px) {
    .band__layer {
      grid-template-columns: 2rem 1fr;
    }
    .band__layer-role {
      grid-column: 2;
      text-align: left;
    }
    .band__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
