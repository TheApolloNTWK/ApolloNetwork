---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contactNav, primaryNav } from '../config/site';
import { link, stripBase } from '../lib/url';

const current = stripBase(Astro.url.pathname);
const isCurrent = (href: string) => (href === '' ? current === '' : current.startsWith(href));
---

<header class="header" data-header>
  <div class="header__inner container">
    <a href={link()} class="header__brand" aria-label="APOLLO Network — home">
      <Logo />
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
      hidden
    >
      <span class="visually-hidden" data-menu-label>
        Open menu
      </span>
      <span class="header__toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <nav id="site-nav" class="header__nav" aria-label="Primary" data-menu>
      <ul class="header__list" role="list">
        {primaryNav.map((item) => (
          <li>
            <a
              href={link(item.href)}
              class="header__link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="header__cta-item">
          <a
            href={link(contactNav.href)}
            class="header__cta"
            aria-current={isCurrent(contactNav.href) ? 'page' : undefined}
          >
            {contactNav.label}
            <Icon name="arrow" size={16} />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard),
      transform var(--dur-slow) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  /* Solid enough to read over any content; blur is light to stay cheap. */
  .header[data-scrolled] {
    background: rgb(3 5 11 / 0.82);
    border-bottom-color: var(--c-line);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .header__inner {
      animation: header-in 0.9s var(--ease-out) backwards;
    }
  }

  @keyframes header-in {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    height: 100%;
  }

  .header__brand {
    position: relative;
    z-index: calc(var(--z-menu) + 1);
    display: inline-flex;
    padding-block: var(--s-2);
    text-decoration: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--s-4), 2.4vw, var(--s-6));
    padding: 0;
    list-style: none;
  }

  .header__link {
    position: relative;
    display: inline-block;
    padding-block: var(--s-2);
    font-size: 0.9rem;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--c-cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    color: var(--c-text);
  }

  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--c-line-signal);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      box-shadow var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard);
  }

  .header__cta:hover,
  .header__cta[aria-current='page'] {
    border-color: var(--c-blue-bright);
    box-shadow: var(--glow-sm);
  }

  /* ── Toggle ─────────────────────────────────────────────── */
  .header__toggle {
    display: none;
    position: relative;
    z-index: calc(var(--z-menu) + 1);
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    background: rgb(3 5 11 / 0.6);
  }

  .header__toggle-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 6px;
  }

  .header__toggle-icon span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--c-text);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-icon span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-icon span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* ── Small screens ───────────────────────────────────────── */
  @media (max-width: 767px) {
    /* Without JavaScript the toggle stays hidden and links simply wrap. */
    .header:not([data-menu-ready]) .header__inner {
      flex-wrap: wrap;
      height: auto;
      padding-block: var(--s-3);
    }

    .header:not([data-menu-ready]) {
      position: absolute;
      height: auto;
      background: var(--c-void);
    }

    .header:not([data-menu-ready]) .header__list {
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-4);
    }

    .header[data-menu-ready] .header__toggle {
      display: block;
    }

    .header[data-menu-ready] .header__nav {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: calc(var(--header-h) + var(--s-6)) var(--gutter) var(--s-8);
      background:
        radial-gradient(120% 60% at 80% 0%, rgb(27 77 255 / 0.18), transparent 60%), var(--c-void);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--dur-base) var(--ease-standard),
        visibility 0s linear var(--dur-base);
    }

    .header[data-menu-open] .header__nav {
      opacity: 1;
      visibility: visible;
      transition:
        opacity var(--dur-base) var(--ease-standard),
        visibility 0s;
    }

    .header[data-menu-ready] .header__list {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }

    .header[data-menu-ready] .header__link {
      font-family: var(--font-display);
      font-size: clamp(2rem, 9vw, 2.75rem);
      font-weight: 500;
      letter-spacing: var(--tracking-heading);
      color: var(--c-text);
    }

    .header[data-menu-ready] .header__link::after {
      display: none;
    }

    .header[data-menu-ready] .header__link[aria-current='page'] {
      color: var(--c-blue-bright);
    }

    .header[data-menu-ready] .header__cta-item {
      margin-top: var(--s-6);
    }

    .header[data-menu-ready] .header__cta {
      min-height: 3rem;
      padding-inline: var(--s-5);
      font-size: 1rem;
    }

    .header[data-menu-ready] .header__list > li {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity var(--dur-base) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
    }

    .header[data-menu-open] .header__list > li {
      opacity: 1;
      transform: none;
    }

    .header[data-menu-open] .header__list > li:nth-child(2) {
      transition-delay: 40ms;
    }
    .header[data-menu-open] .header__list > li:nth-child(3) {
      transition-delay: 80ms;
    }
    .header[data-menu-open] .header__list > li:nth-child(4) {
      transition-delay: 120ms;
    }
    .header[data-menu-open] .header__list > li:nth-child(5) {
      transition-delay: 160ms;
    }
  }
</style>
