---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerNav, site } from '../config/site';
import { link } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo size="lg" />
        <p class="footer__line">
          A personal intelligence environment.
          <br />
          Built independently. Released when it is ready.
        </p>
      </div>

      <div class="footer__nav">
        {footerNav.map((group) => (
          <nav aria-label={group.heading} class="footer__group">
            <h2 class="label">{group.heading}</h2>
            <ul role="list">
              {group.items.map((item) => (
                <li>
                  <a href={link(item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        <div class="footer__group">
          <h2 class="label">Elsewhere</h2>
          <ul role="list">
            <li>
              <a href={site.github} rel="noopener noreferrer external" class="footer__ext">
                <Icon name="github" size={16} />
                GitHub<span class="visually-hidden"> (opens external site)</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__verbs" aria-hidden="true">
      <span>Understand</span>
      <span class="footer__sep"></span>
      <span>Build</span>
      <span class="footer__sep"></span>
      <span>Execute</span>
    </div>

    <div class="footer__bottom">
      <p>
        © {year} {site.name}
      </p>
      <p>
        No cookies. No trackers. <a href={link('privacy/')}>Privacy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: var(--s-9) var(--s-6);
    border-top: var(--border);
    background: linear-gradient(180deg, var(--c-space) 0%, var(--c-void) 100%);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  .footer__top {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 1024px) {
    .footer__top {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .footer__line {
    margin-top: var(--s-5);
    max-width: 28ch;
    line-height: var(--lh-snug);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }

  @media (min-width: 768px) {
    .footer__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .footer__group ul {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-4);
    padding: 0;
    list-style: none;
  }

  .footer a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 1.75rem;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .footer a:hover {
    color: var(--c-text);
  }

  .footer__verbs {
    display: flex;
    align-items: center;
    gap: clamp(var(--s-3), 3vw, var(--s-7));
    margin-block: var(--s-9) var(--s-6);
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.3rem + 2.5vw, 2.75rem);
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-text-subtle);
    white-space: nowrap;
  }

  .footer__verbs span:not(.footer__sep) {
    background: linear-gradient(180deg, var(--c-text-muted), var(--c-navy));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (max-width: 639px) {
    .footer__verbs {
      gap: var(--s-2);
      font-size: 0.8rem;
      letter-spacing: 0.16em;
    }
  }

  .footer__sep {
    flex: 1;
    min-width: 0.75rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-line-signal), transparent);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: var(--border);
    color: var(--c-text-subtle);
  }

  .footer__bottom a {
    min-height: 1.75rem;
    text-decoration: underline;
    text-decoration-color: var(--c-line-strong);
  }
</style>
