---
/**
 * The APOLLO assistant: a guided helper, not an AI.
 *
 * Every answer is pre-rendered into a <template> and cloned by the script,
 * so no HTML strings are ever parsed (Trusted Types stays enforced) and no
 * network requests are made. Hidden entirely without JavaScript.
 */
import { assistantGreeting, assistantTopics } from '../data/assistant';
import { link } from '../lib/url';

interface Props {
  /** Offer the "What can I help you with today?" greeting on this page. */
  greet?: boolean;
}

const { greet = false } = Astro.props;
---

<div class="assistant" data-assistant data-assistant-greet={greet ? '' : undefined} hidden>
  <div class="assistant__bubble" data-assistant-bubble hidden>
    <p>{assistantGreeting}</p>
    <button type="button" class="assistant__bubble-close" data-assistant-dismiss>
      <span class="visually-hidden">Dismiss</span>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <section
    id="assistant-panel"
    class="assistant__panel"
    role="dialog"
    aria-labelledby="assistant-title"
    aria-describedby="assistant-note"
    data-assistant-panel
    hidden
  >
    <div class="assistant__head">
      <span class="assistant__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" focusable="false">
          <circle cx="16" cy="16" r="3.2"></circle>
          <ellipse cx="16" cy="16" rx="13" ry="5.5" transform="rotate(-28 16 16)"></ellipse>
        </svg>
      </span>
      <div class="assistant__heading">
        <h2 id="assistant-title" class="assistant__title">
          APOLLO assistant
        </h2>
        <p id="assistant-note" class="assistant__note">
          Guided answers — not AI. Nothing you choose leaves your browser.
        </p>
      </div>
      <button type="button" class="assistant__close" data-assistant-close>
        <span class="visually-hidden">Close assistant</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <div class="assistant__log" data-assistant-log aria-live="polite">
      <p class="assistant__msg assistant__msg--bot">{assistantGreeting}</p>
    </div>

    <div class="assistant__choices" role="group" aria-label="Choose a topic">
      {assistantTopics.map((t) => (
        <button type="button" class="assistant__choice" data-topic={t.id}>
          {t.prompt}
        </button>
      ))}
    </div>
  </section>

  <button
    type="button"
    class="assistant__launcher"
    aria-expanded="false"
    aria-controls="assistant-panel"
    data-assistant-toggle
  >
    <svg class="assistant__launcher-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="3.2"></circle>
      <ellipse cx="16" cy="16" rx="13" ry="5.5" transform="rotate(-28 16 16)"></ellipse>
      <circle class="assistant__launcher-node" cx="27.3" cy="10" r="1.9"></circle>
    </svg>
    <span class="assistant__launcher-label">Ask APOLLO</span>
  </button>

  {assistantTopics.map((t) => (
    <template data-answer={t.id}>
      <div class="assistant__msg assistant__msg--bot">
        <p>{t.answer}</p>
        <ul class="assistant__links" role="list">
          {t.links.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </template>
  ))}
</div>

<script>
  import { initAssistant } from '../scripts/assistant';
  initAssistant();
</script>

<style>
  .assistant {
    --assistant-gap: clamp(0.75rem, 2vw, 1.5rem);
    position: fixed;
    right: var(--assistant-gap);
    bottom: var(--assistant-gap);
    z-index: calc(var(--z-header) + 5);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-3);
    pointer-events: none;
  }

  .assistant > * {
    pointer-events: auto;
  }

  /* ── Launcher ───────────────────────────────────────────── */
  .assistant__launcher {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 3rem;
    padding: 0.55rem 1rem 0.55rem 0.7rem;
    border: 1px solid rgb(91 134 255 / 0.6);
    border-radius: var(--radius-pill);
    background: rgb(5 8 20 / 0.92);
    box-shadow:
      0 12px 32px -12px rgb(0 0 0 / 0.9),
      var(--glow-sm);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--c-text);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      border-color var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard);
  }

  .assistant__launcher:hover,
  .assistant__launcher[aria-expanded='true'] {
    border-color: var(--c-cyan);
    box-shadow:
      0 12px 32px -12px rgb(0 0 0 / 0.9),
      var(--glow-md);
  }

  .assistant__launcher-icon {
    width: 1.6rem;
    height: 1.6rem;
  }

  .assistant__launcher-icon circle,
  .assistant__mark circle {
    fill: var(--c-text);
  }

  .assistant__launcher-icon ellipse,
  .assistant__mark ellipse {
    fill: none;
    stroke: var(--c-blue-bright);
    stroke-width: 1.4;
  }

  .assistant__launcher-icon .assistant__launcher-node {
    fill: var(--c-cyan);
  }

  @media (prefers-reduced-motion: no-preference) {
    .assistant__launcher-icon ellipse {
      transform-origin: 16px 16px;
      animation: assistant-orbit 12s linear infinite;
    }
  }

  @keyframes assistant-orbit {
    to {
      rotate: 360deg;
    }
  }

  @media (max-width: 479px) {
    .assistant__launcher {
      padding-right: 0.7rem;
    }
    .assistant__launcher-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ── Greeting bubble ────────────────────────────────────── */
  .assistant__bubble {
    position: relative;
    max-width: 16rem;
    padding: var(--s-3) var(--s-7) var(--s-3) var(--s-4);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    background: rgb(8 13 28 / 0.96);
    box-shadow: var(--shadow-panel);
    font-size: var(--fs-small);
    color: var(--c-text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .assistant__bubble:not([hidden]) {
      animation: assistant-in 0.6s var(--ease-out) backwards;
    }
  }

  .assistant__bubble-close {
    position: absolute;
    top: 50%;
    right: var(--s-2);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xs);
    background: none;
    color: var(--c-text-muted);
    transform: translateY(-50%);
  }

  .assistant__bubble-close path,
  .assistant__close path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* ── Panel ──────────────────────────────────────────────── */
  .assistant__panel {
    display: flex;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2 * var(--assistant-gap)));
    max-height: min(34rem, calc(100dvh - 6.5rem));
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(180deg, rgb(11 30 58 / 0.55), rgb(5 8 20 / 0.98) 40%), var(--c-space);
    box-shadow: var(--shadow-panel), var(--glow-sm);
    overflow: hidden;
  }

  .assistant__panel[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .assistant__panel:not([hidden]) {
      animation: assistant-in 0.45s var(--ease-out) backwards;
    }
  }

  @keyframes assistant-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }

  .assistant__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    border-bottom: var(--border);
  }

  .assistant__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--border-strong);
    border-radius: 50%;
  }

  .assistant__mark svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .assistant__title {
    font-size: 1rem;
    font-weight: 500;
  }

  .assistant__note {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--c-text-subtle);
  }

  .assistant__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: none;
    color: var(--c-text-muted);
  }

  .assistant__close:hover,
  .assistant__bubble-close:hover {
    color: var(--c-text);
  }

  .assistant__log {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 5rem;
  }

  .assistant__msg {
    max-width: 90%;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .assistant__msg--bot {
    align-self: flex-start;
    border: var(--border);
    background: rgb(3 5 11 / 0.6);
    color: var(--c-text);
  }

  .assistant__msg--user {
    align-self: flex-end;
    border: 1px solid rgb(91 134 255 / 0.5);
    background: rgb(27 77 255 / 0.18);
    color: var(--c-text);
  }

  .assistant__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding: 0;
    list-style: none;
  }

  .assistant__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--c-line-signal);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    color: var(--c-text);
    text-decoration: none;
  }

  .assistant__links a:hover {
    border-color: var(--c-cyan);
  }

  .assistant__choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4) var(--s-4);
    border-top: var(--border);
    max-height: 11rem;
    overflow-y: auto;
  }

  .assistant__choice {
    min-height: 2.25rem;
    padding: 0.3rem 0.8rem;
    border: var(--border-strong);
    border-radius: var(--radius-pill);
    background: rgb(3 5 11 / 0.5);
    font-size: 0.8125rem;
    color: var(--c-text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .assistant__choice:hover {
    border-color: var(--c-line-signal);
    color: var(--c-text);
  }

  @media (forced-colors: active) {
    .assistant__launcher,
    .assistant__panel,
    .assistant__choice {
      border-color: ButtonText;
    }
  }
</style>
