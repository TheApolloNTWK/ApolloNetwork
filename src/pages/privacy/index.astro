---
import LegalLayout from '../../layouts/LegalLayout.astro';
import EmailReveal from '../../components/EmailReveal.astro';
import { legal } from '../../config/legal';
import { processing } from '../../data/legal/processing';
import { link } from '../../lib/url';

const toc = [
  { id: 'who', title: 'Who we are' },
  { id: 'collect', title: 'What this website collects' },
  { id: 'contact', title: 'When you contact us' },
  { id: 'browser', title: 'What stays in your browser' },
  { id: 'never', title: 'What we do not do' },
  { id: 'transfers', title: 'International transfers' },
  { id: 'rights', title: 'Your rights' },
  { id: 'security', title: 'Security' },
  { id: 'children', title: 'Children' },
  { id: 'links', title: 'Other websites' },
  { id: 'future', title: 'New features' },
  { id: 'changes', title: 'Changes to this policy' },
  { id: 'questions', title: 'Questions and requests' },
];
---

<LegalLayout
  doc="privacy"
  description="How the APOLLO Network website handles personal data: no cookies, no analytics, no trackers — and exactly what happens when you get in touch."
  lead="This website is built to collect as little as possible. It sets no cookies, runs no analytics and loads no third-party scripts. This policy explains exactly what does happen, and your rights."
  toc={toc}
  summary={[
    'The website itself collects nothing about you: no cookies, no analytics, no tracking, nothing stored on your device.',
    'Our host, GitHub, logs visitor IP addresses for security. We do not receive or use those logs.',
    'If you email us or open an enquiry, we use what you send only to reply and to discuss the work you ask about.',
    'We never sell your data or use it for advertising.',
  ]}
>
  <section id="who" aria-labelledby="who-title">
    <h2 id="who-title">Who we are</h2>
    <p>
      {legal.operator} is {legal.operatorDescription} operated from {legal.location}. In this
      policy, “{legal.operator}”, “we” and “us” mean the person operating {legal.operator}, who is
      responsible for the personal data described here (the “controller” under UK data protection
      law).
    </p>
    <p>
      This policy covers this website and the ways you can contact us from it. It is written with
      the UK GDPR, the Data Protection Act 2018 and the Privacy and Electronic Communications
      Regulations (PECR) in mind.
    </p>
  </section>

  <section id="collect" aria-labelledby="collect-title">
    <h2 id="collect-title">What this website collects</h2>
    <p>
      <strong>Nothing, directly.</strong> The website has no database, no accounts, no analytics, no
      advertising and no tracking. It sets no cookies and stores nothing on your device. Fonts,
      images and scripts are served from this site itself, so your browser does not contact any
      other company while you read it.
    </p>
    <p>
      The site is hosted on GitHub Pages. According to GitHub, when a GitHub Pages site is visited,
      the visitor’s IP address is logged and stored for security purposes. That logging is done by
      GitHub under its own privacy statement; we do not receive, access or use those logs.
    </p>
  </section>

  <section id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">When you contact us</h2>
    <p>
      Personal data reaches us only if you choose to send it. Each way that can happen is listed
      below.
    </p>
    {processing.map((p) => (
      <div class="activity">
        <h3>{p.activity}</h3>
        <dl>
          <div>
            <dt>Information</dt>
            <dd>{p.data}</dd>
          </div>
          <div>
            <dt>Why</dt>
            <dd>{p.purpose}</dd>
          </div>
          <div>
            <dt>Legal basis</dt>
            <dd>{p.basis}</dd>
          </div>
          <div>
            <dt>Provided by</dt>
            <dd>
              {p.recipients.map((r, i) => (
                <>
                  {i > 0 && '; '}
                  <a href={r.policy} rel="noopener noreferrer external">
                    {r.name}
                    <span class="visually-hidden"> privacy policy (opens external site)</span>
                  </a>
                  , which {r.role}
                </>
              ))}
            </dd>
          </div>
          <div>
            <dt>Kept for</dt>
            <dd>{p.retention}</dd>
          </div>
        </dl>
      </div>
    ))}
    <p>Please do not send passwords, financial details or other sensitive personal information.</p>
  </section>

  <section id="browser" aria-labelledby="browser-title">
    <h2 id="browser-title">What stays in your browser</h2>
    <p>
      <strong>The enquiry form</strong> on the contact page does not send anything. It prepares a
      message in your own email app; nothing leaves your device until you press send there, at which
      point the email section above applies.
    </p>
    <p>
      <strong>The APOLLO assistant</strong> is a guided helper, not an AI. Its answers are built
      into the page, and nothing you choose in it is sent or stored anywhere.
    </p>
  </section>

  <section id="never" aria-labelledby="never-title">
    <h2 id="never-title">What we do not do</h2>
    <ul>
      <li>We do not sell, rent or trade personal data.</li>
      <li>We do not use your data for advertising or build profiles of visitors.</li>
      <li>We do not add you to mailing lists or send marketing you have not asked for.</li>
      <li>We do not make automated decisions about you.</li>
    </ul>
  </section>

  <section id="transfers" aria-labelledby="transfers-title">
    <h2 id="transfers-title">International transfers</h2>
    <p>
      GitHub and Google are international providers and may process data outside the UK, including
      in the United States. Their privacy statements, linked above, explain the safeguards they rely
      on for international transfers.
    </p>
  </section>

  <section id="rights" aria-labelledby="rights-title">
    <h2 id="rights-title">Your rights</h2>
    <p>Under UK data protection law you have the right to:</p>
    <ul>
      <li>ask for a copy of the personal data we hold about you;</li>
      <li>ask us to correct it, or to delete it;</li>
      <li>ask us to restrict how we use it, or object to our using it;</li>
      <li>ask for data you gave us in a portable format, where that right applies.</li>
    </ul>
    <p>
      Some rights have exceptions, and we will tell you if one applies. To make a request, contact
      us as described below. You also have the right to complain to the{' '}
      <a href={legal.regulator.complaintsUrl} rel="noopener noreferrer external">
        {legal.regulator.name}
        <span class="visually-hidden"> (opens external site)</span>
      </a>
      , the UK data protection regulator. We would appreciate the chance to deal with your concern
      first.
    </p>
  </section>

  <section id="security" aria-labelledby="security-title">
    <h2 id="security-title">Security</h2>
    <p>
      The website is static, with no server-side code, database or user accounts, and a strict
      browser security policy. Messages you send us are held only in the email and GitHub services
      described above. No system is perfectly secure; see our{' '}
      <a href={link('security/')}>security page</a> to report a concern.
    </p>
  </section>

  <section id="children" aria-labelledby="children-title">
    <h2 id="children-title">Children</h2>
    <p>
      This website is aimed at businesses and adults. We do not knowingly collect personal data from
      children.
    </p>
  </section>

  <section id="links" aria-labelledby="links-title">
    <h2 id="links-title">Other websites</h2>
    <p>
      Links to other websites, such as GitHub, take you to services with their own privacy policies.
      Pages instruct your browser not to send a referrer when you follow those links, so other sites
      are not told which page you came from.
    </p>
  </section>

  <section id="future" aria-labelledby="future-title">
    <h2 id="future-title">New features</h2>
    <p>
      APOLLO Network may add features in future that handle more information — for example an AI
      assistant, analytics, accounts or online payments. None of these are active today. This policy
      will be updated to describe any such feature, including who processes the data and why, before
      it goes live.
    </p>
  </section>

  <section id="changes" aria-labelledby="changes-title">
    <h2 id="changes-title">Changes to this policy</h2>
    <p>
      When this policy changes, the “last updated” date at the top of the page changes with it.
      Significant changes will be made clear on this page.
    </p>
  </section>

  <section id="questions" aria-labelledby="questions-title">
    <h2 id="questions-title">Questions and requests</h2>
    <p>
      For privacy questions or to exercise your rights, email APOLLO Network: <EmailReveal /> You
      can also use the <a href={link('contact/')}>contact page</a>. Please do not use a public
      GitHub enquiry for privacy requests.
    </p>
  </section>
</LegalLayout>

<style>
  .activity {
    margin-top: var(--s-5);
    padding: var(--s-5);
    border: var(--border);
    border-radius: var(--radius-sm);
    background: rgb(8 13 28 / 0.6);
  }

  .activity h3 {
    margin-top: 0;
  }

  .activity dl {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .activity dl > div {
    display: grid;
    gap: var(--s-1);
  }

  @media (min-width: 640px) {
    .activity dl > div {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--s-4);
    }
  }

  .activity dt {
    font-family: var(--font-display);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-text-subtle);
    padding-top: 0.2em;
  }

  .activity dd {
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }
</style>
