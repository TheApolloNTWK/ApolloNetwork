---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';

const updated = '24 September 2026';
---

<BaseLayout
  path="privacy/"
  title="Privacy"
  description="How the APOLLO Network website handles your data: no cookies, no analytics, no trackers and no third-party scripts."
>
  <PageIntro
    eyebrow="Privacy"
    title="Privacy, briefly."
    lead="This website does not use cookies, analytics, trackers, advertising pixels or third-party scripts. That is the short version, and it is the whole version."
  />

  <section class="section">
    <div class="container split">
      <div class="split__aside">
        <p class="label">Last updated</p>
        <p class="updated">{updated}</p>
      </div>
      <div class="prose">
        <h2>What this site collects</h2>
        <p>
          Nothing, directly. There are no cookies, no local storage used for tracking, no analytics
          and no fingerprinting. Fonts, images and scripts are all served from this site itself, so
          your browser does not contact any other company while you read it.
        </p>

        <h2>Hosting</h2>
        <p>
          The site is hosted on GitHub Pages. Like any web host, GitHub processes technical data
          such as IP addresses to deliver pages and keep the service secure. That processing is
          governed by the{' '}
          <a
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            rel="noopener noreferrer external"
          >
            GitHub General Privacy Statement
            <span class="visually-hidden"> (opens external site)</span>
          </a>
          .
        </p>

        <h2>If you get in touch</h2>
        <p>
          The contact page never sends data anywhere by itself. If you choose to email APOLLO
          Network, your message is handled only to reply to you, and is not shared or sold. Please
          do not include passwords or sensitive personal information.
        </p>

        <h2>Leaving the site</h2>
        <p>
          Pages instruct your browser not to send a referrer when you follow a link elsewhere, so
          other sites are not told which page you came from.
        </p>

        <h2>Changes</h2>
        <p>
          If this ever changes — for example, if privacy-preserving analytics are introduced — this
          page will be updated first, and will say exactly what is collected and why.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .updated {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
  }

  .prose :global(h2) {
    margin-top: 2em;
    font-size: var(--fs-h3);
    color: var(--c-text);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
